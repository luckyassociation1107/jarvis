# Copied out of node_modules by scripts/start.mjs — 34MB of build output.
public/mediapipe/

# --- Flutter / Dart (launcher/) ---
# Everything below is generated by `flutter create` or `flutter pub get` and is
# either rebuildable or machine-specific. Committing any of it would put
# hundreds of MB of intermediates into history on the first push.
launcher/.dart_tool/
launcher/build/
launcher/.flutter-plugins
launcher/.flutter-plugins-dependencies
launcher/.packages
launcher/pubspec.lock
# Generated by `flutter create`, not hand-written. See launcher/README.md for
# the exact command; the repo ships only the files that must override it.
launcher/android/.gradle/
launcher/android/local.properties
launcher/android/app/debug/
launcher/android/app/release/
launcher/ios/
launcher/linux/
launcher/macos/
launcher/web/
launcher/windows/flutter/
launcher/windows/ephemeral/
# Installer output
launcher/installer/dist/
# IDE
launcher/.idea/
launcher/*.iml

# Models downloaded by the autopilot. Multi-gigabyte and machine-specific, so
# they belong in the cache, never in git.
models/
*.gguf
*.bin
!launcher/assets/**

# Build and installer output
launcher/build/
launcher/.dart_tool/
launcher/windows/flutter/ephemeral/
*.exe
*.msix
*.zip
*.tar.zst

# Tooling dirs that are local-only
.claude/
.arena/
