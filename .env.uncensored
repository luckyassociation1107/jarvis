# JARVIS Uncensored Model Configuration
# Copy this to .env or set these environment variables
# Optimized for: i5-12400F + 16GB DDR4 + CPU-only

# ─── Model Slots ───
# Each slot routes to a specific uncensored model

JARVIS_MODEL_CHAT=dolphin3:8b
JARVIS_MODEL_VISION=qwen3-vl:4b
JARVIS_MODEL_REASON=dolphin3:8b
JARVIS_MODEL_CODER=huihui_ai/qwen2.5-coder-abliterate:7b

# ─── Performance ───
JARVIS_MODEL_TEMPERATURE=0.6
JARVIS_MODEL_TIMEOUT_MS=180000
JARVIS_MODEL_MAX_TURNS=8

# ─── Ollama ───
JARVIS_OLLAMA_URL=http://localhost:11434

# ─── Hardware ───
# i5-12400F: 10 threads optimal, CPU-only, mmap=true
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_FLASH_ATTENTION=0